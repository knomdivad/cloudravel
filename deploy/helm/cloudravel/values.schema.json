{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "CloudRavel Helm chart values",
  "description": "Validated by Helm on install, upgrade, lint, and template. Deliberately permissive about additions and strict about the shapes that fail late or silently: wrong types, unknown modes, and negative replica counts.",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string" } },
        "required": ["name"]
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "api": { "$ref": "#/definitions/imageRef" },
        "web": { "$ref": "#/definitions/imageRef" },
        "migrator": { "$ref": "#/definitions/imageRef" }
      },
      "required": ["registry", "pullPolicy"]
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "mssqlSaPassword": { "type": "string" },
        "localAuthJwtSigningKey": { "type": "string" },
        "openBaoToken": { "type": "string" },
        "openAiApiKey": { "type": "string" }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "service": { "$ref": "#/definitions/servicePort" },
        "platformEnvironment": {
          "type": "string",
          "enum": ["Development", "Production"],
          "description": "Production is what enables live cloud collection."
        },
        "corsAllowedOrigins": { "type": "string" },
        "resources": { "$ref": "#/definitions/resources" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "service": { "$ref": "#/definitions/servicePort" },
        "resources": { "$ref": "#/definitions/resources" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "annotations": { "type": "object" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    },
    "mssql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "service": { "$ref": "#/definitions/servicePort" },
        "persistence": { "$ref": "#/definitions/persistence" },
        "resources": { "$ref": "#/definitions/resources" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" }
      }
    },
    "externalMssql": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "database": { "type": "string" },
        "user": { "type": "string" }
      }
    },
    "azurite": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "persistence": { "$ref": "#/definitions/persistence" },
        "resources": { "$ref": "#/definitions/resources" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" }
      }
    },
    "externalStorage": {
      "type": "object",
      "properties": { "connectionString": { "type": "string" } }
    },
    "openbao": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "service": { "$ref": "#/definitions/servicePort" },
        "mode": {
          "type": "string",
          "enum": ["file", "dev"],
          "description": "dev keeps secrets in memory and loses them on restart."
        },
        "persistence": { "$ref": "#/definitions/persistence" },
        "resources": { "$ref": "#/definitions/resources" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" }
      }
    },
    "externalOpenBao": {
      "type": "object",
      "properties": {
        "address": { "type": "string" },
        "tokenFile": { "type": "string" }
      }
    },
    "migrator": {
      "type": "object",
      "properties": {
        "image": { "type": "string" },
        "resources": { "$ref": "#/definitions/resources" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressNamespaceSelector": { "type": "object" }
      }
    }
  },
  "definitions": {
    "imageRef": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" }
      },
      "required": ["repository"]
    },
    "servicePort": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)?$" },
        "storageClass": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "$ref": "#/definitions/resourceQuantities" },
        "limits": { "$ref": "#/definitions/resourceQuantities" }
      }
    },
    "resourceQuantities": {
      "type": "object",
      "properties": {
        "cpu": { "type": ["string", "number"] },
        "memory": { "type": "string" }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    }
  }
}
