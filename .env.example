# ============================================================================
# AnanVision local / OrbStack stack configuration. Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored — never commit real secrets.
# ============================================================================

# --- SQL Server (required) ---
# Must satisfy SQL Server complexity: 8+ chars, upper, lower, digit/symbol.
MSSQL_SA_PASSWORD=Your_Strong_Passw0rd!

# --- Local auth (recommended: set a strong random key) ---
# Signs the JWTs issued by the local username/password login path.
# Any non-empty string works for dev; use a long random value in production.
LOCAL_AUTH_JWT_SIGNING_KEY=dev-only-change-me-in-production

# --- OpenBao secret store ---
# Dev mode uses the fixed root token 'root' (see docker-compose.yml). Change
# both here and in a real OpenBao/Vault deployment for anything beyond local.
OPENBAO_TOKEN=root

# --- AI model (optional — only the AI Insights page needs it) ---
# Any OpenAI-compatible endpoint (Azure OpenAI, OpenAI, or a self-hosted
# gateway). Leave blank to run without AI; all other pages work.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.5

# --- Entra ID SSO (OPTIONAL) ---
# Local login works without any of these. Provide them only if you also want
# Entra ID single sign-on. NEXT_PUBLIC_* are baked into the web image at build
# time, so re-run `docker compose up --build web` after changing them.
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
NEXT_PUBLIC_AZURE_AD_TENANT_ID=
NEXT_PUBLIC_API_SCOPE=
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
