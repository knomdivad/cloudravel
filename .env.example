# ============================================================================
# Local / OrbStack stack configuration. Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored — never commit real secrets.
# ============================================================================

# --- SQL Server (required) ---
# Must satisfy SQL Server complexity: 8+ chars, upper, lower, digit/symbol.
MSSQL_SA_PASSWORD=Your_Strong_Passw0rd!

# --- Frontend / Entra ID (required for the login screen) ---
# The SPA gates all pages behind MSAL login, so these must be real values from
# your Entra ID app registration. Use the SAME values you already deployed with.
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_API_SCOPE=api://aim-api/.default

# --- Backend Entra ID (optional locally; JWT is not enforced by the API) ---
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Azure OpenAI (optional — only the AI Insights page needs it) ---
# Leave blank to run without AI; all other pages work.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.5
