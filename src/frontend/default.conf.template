server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ------------------------------------------------------------------
    # API reverse proxy → Azure Functions host (same-origin, no CORS).
    # The Functions runtime serves under /api/*, so the original URI is
    # forwarded unchanged (proxy_pass has no path component).
    #
    # The upstream is ${API_UPSTREAM} rather than a hardcoded host so the
    # same image works whatever the API service is called (compose service
    # `api`, or a Helm-templated Kubernetes Service name). The nginx image's
    # envsubst step fills it in at container start from the API_UPSTREAM env
    # var (default api:80, set in the Dockerfile); nginx's own $uri/$host/
    # $scheme are left untouched because they're not defined env vars.
    #
    # DNS re-resolve: a bare `proxy_pass http://api:80` caches the IP at
    # nginx start. After `docker compose up --force-recreate api`, that IP
    # is dead and the UI 502s on /api/* (including login). Using a variable
    # + resolver forces a fresh lookup. NGINX_LOCAL_RESOLVERS comes from
    # the official nginx entrypoint when NGINX_ENTRYPOINT_LOCAL_RESOLVERS
    # is set (reads /etc/resolv.conf — works on Docker, Podman, and k8s).
    # ------------------------------------------------------------------
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    location /api/ {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_connect_timeout 10s;
        proxy_next_upstream error timeout http_502 http_503;
    }

    # ------------------------------------------------------------------
    # Static SPA. Next's static export emits <route>.html files, so try the
    # exact file, then <route>.html, then a directory index, then fall back
    # to the app shell for client-side routing.
    # ------------------------------------------------------------------
    location / {
        try_files $uri $uri.html $uri/index.html /index.html;
    }
}
